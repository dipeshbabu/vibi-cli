    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cybermind/shared": "workspace:*",
    "commander": "^15.0.0",
    "tsx": "^4.23.15",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.6"
  }
}
